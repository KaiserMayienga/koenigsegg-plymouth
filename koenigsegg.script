img[18] = Image("pieces/p18.png");
px[19] = 186; py[19] = 301; cxp[19] = 202.0; dx[19] = 142.9; dy[19] = 20.0; tin[19] = 31;
img[19] = Image("pieces/p19.png");

ox = Window.GetWidth() / 2 - LW / 2;
oy = Window.GetHeight() / 2 - LH / 2;

for (n = 0; n < N; n++) {
    spr[n] = Sprite(img[n]);
    spr[n].SetOpacity(0);
    spr[n].SetPosition(ox + px[n], oy + py[n], 10);
    trl[n] = Sprite(img[n]);
    trl[n].SetOpacity(0);
    trl[n].SetPosition(ox + px[n], oy + py[n], 9);
}

tick = 0;

fun clamp01(v) {
    return Math.Min(Math.Max(v, 0), 1);
}

fun offset(t, n) {
    u = clamp01((t - tin[n]) / DIN);
    v = 1 - u;
    return v * v * v * v * v * FIN;
}

fun alpha(t, n) {
    u = clamp01((t - tin[n]) / DIN);
    v = 1 - u;
    return 1 - v * v * v;
}

fun bright(t, n) {
    sx = SW0 + (t - SW_START) * SW_SPEED;
    if (sx >= cxp[n]) {
        b = 1;
    } else {
        b = 1 - (cxp[n] - sx) / SW_W;
        if (b < 0) b = 0;
    }
    return BASE + GAIN * b;
}

fun refresh() {
    if (tick < SETTLE) {
        t = tick;
        for (n = 0; n < N; n++) {
            o = offset(t, n);
            spr[n].SetPosition(ox + px[n] + dx[n] * o, oy + py[n] + dy[n] * o, 10);
            spr[n].SetOpacity(alpha(t, n) * bright(t, n));
            tt = t - LAG;
            if (tt < 0) tt = 0;
            o2 = offset(tt, n);
            moved = o2 - o;
            if (moved < 0) moved = 0 - moved;
            if (moved > 0.02) {
                trl[n].SetPosition(ox + px[n] + dx[n] * o2, oy + py[n] + dy[n] * o2, 9);
                trl[n].SetOpacity(alpha(tt, n) * TRAIL);
            } else {
                trl[n].SetOpacity(0);
            }
        }
        tick++;
    }
}
Plymouth.SetRefreshFunction(refresh);
