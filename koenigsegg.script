Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

LW = 301;
LH = 420;
N = 20;
DIN = 40;
FIN = 1.7;
SW0 = -40;
SW_SPEED = 4.0;
SW_W = 85;
SW_START = 62;
BASE = 0.86;
GAIN = 0.14;
LAG = 6;
TRAIL = 0.28;
SETTLE = 220;

px[0] = 0; py[0] = 0; cxp[0] = 150.5; dx[0] = 0; dy[0] = 60; tin[0] = 6;
img[0] = Image("pieces/p0.png");
